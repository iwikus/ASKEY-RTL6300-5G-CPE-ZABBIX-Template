                            <name>5G: Device is in ROAMING</name>
                            <priority>INFO</priority>
                            <description>Zariadenie je v roamingu.</description>
                            <tags>
                                <tag>
                                    <tag>scope</tag>
                                    <value>notice</value>
                                </tag>
                            </tags>
                        </trigger>
