                <item>
                    <uuid>f035e3c7062a473c9ce8a9c44c3a993e</uuid>
                    <name>5G: Raw signal_info JSON</name>
                    <type>HTTP_AGENT</type>
                    <key>lte.signal_info.raw</key>
                    <delay>60s</delay>
                    <history>1d</history>
                    <value_type>TEXT</value_type>
                    <trends>0</trends>
                    <description>Master item – RF parametre LTE aj 5G.</description>
                    <url>http://{HOST.CONN}/restful/lte/signal_info</url>
                    <tags>
                        <tag>
                            <tag>component</tag>
                            <value>signal</value>
                        </tag>
                    </tags>
                </item>
                <item>
                    <uuid>1ef28eb27ba34c90bf1973545043d976</uuid>
                    <name>5G: Signal level</name>
                    <type>DEPENDENT</type>
                    <key>lte.signal_level</key>
                    <delay>0</delay>
                    <history>7d</history>
                    <trends>90d</trends>
                    <description>Úroveň signálu 0–5.</description>
                    <preprocessing>
                        <step>
                            <type>JSONPATH</type>
                            <parameters>
                                <parameter>$.Result.signal_level</parameter>
                            </parameters>
                        </step>
                        <step>
                            <type>IN_RANGE</type>
                            <parameters>
                                <parameter>0</parameter>
                                <parameter>5</parameter>
                            </parameters>
                            <error_handler>DISCARD_VALUE</error_handler>
                        </step>
                    </preprocessing>
                    <master_item>
                        <key>lte.status_info.raw</key>
                    </master_item>
                    <tags>
                        <tag>
                            <tag>component</tag>
                            <value>signal</value>
                        </tag>
                    </tags>
                    <triggers>
                        <trigger>
                            <uuid>2fc2d10476ac4568a0dbfea993061c64</uuid>
                            <expression>last(/Askey 5G/lte.signal_level)&lt;=1</expression>
                            <name>5G: Signal level is CRITICAL ({ITEM.VALUE}/5)</name>
                            <priority>HIGH</priority>
                            <description>Signál je kriticky slabý (≤ 1/5).</description>
                            <tags>
                                <tag>
                                    <tag>scope</tag>
                                    <value>performance</value>
                                </tag>
                            </tags>
                        </trigger>
                        <trigger>
                            <uuid>0cefd02116db44b1955287262753caa4</uuid>
                            <expression>last(/Askey 5G/lte.signal_level)&lt;3 and last(/Askey 5G/lte.signal_level)&gt;1</expression>
                            <name>5G: Signal level is LOW ({ITEM.VALUE}/5)</name>
                            <priority>WARNING</priority>
                            <description>Signál je slabý (&lt; 3/5).</description>
                            <tags>
                                <tag>
                                    <tag>scope</tag>
                                    <value>performance</value>
                                </tag>
                            </tags>
                        </trigger>
                    </triggers>
                </item>
