                            <priority>WARNING</priority>
                            <description>Zariadenie nie je pripojené cez 5G. Aktuálna technológia: {ITEM.VALUE}</description>
                            <tags>
                                <tag>
                                    <tag>scope</tag>
                                    <value>availability</value>
                                </tag>
                            </tags>
                        </trigger>
                    </triggers>
                </item>
